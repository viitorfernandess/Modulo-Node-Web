// Página HTML inicial

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Newsletter de Tecnologia</title>
</head>

<body>
    <div class="container"> // é uma classe CSS que pode ser usada para estilizar essa div com CSS.
        <h1>Assine nossa Newsletter</h1>
        <p>Fique por dentro das últimas novidades sobre Node.js e desenvolvimento web backend!</p>

        <form action="/signup" method="post" class="signup-form">
            <input type="email" name="email" id="email" placeholder="Digite seu e-mail" required>
            <button type="submit">Inscrever-se</button>
        </form>
    </div>
</body>

</html>